# ==============================================================================
# Git Ignore Configuration for gemini-web-to-api & Antigravity Suite
# ==============================================================================

# Binaries and compiled executables
*.exe
*.exe~
*.dll
*.so
*.dylib
gemini-web-to-api
gemini-web-to-api.exe

# Go test binaries and coverage profiles
*.test
*.out
coverage.*
*.coverprofile
profile.cov
go.work
go.work.sum
guide.md

# User Account Data & Sensitive Credentials (NEVER COMMIT)
.cookies/
.env
*.env
.env.*
!.env.example
accounts/*.env
accounts/accounts.json
instances/

# Runtime Logs, PIDs, and Temporary Caches
*.log
*.pid
tmp/
tempProfile/
gemini_api_gui_profile/
antigravity-bridge/*.log
antigravity-bridge/*.pid

# Dependencies
node_modules/
# vendor/

# Configuration overrides
config.yml

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Python cache and generated test outputs
examples/__pycache__/
examples/generated_video*.mp4
examples/generated_canvas_*
examples/generated_music_*
