{
  "manifest_version": 3,
  "name": "Gemini Web to API - Cookie Sync",
  "version": "1.0.0",
  "description": "Tự động trích xuất và đồng bộ Cookie Google Gemini sang gemini-web-to-api theo Port của từng Profile chỉ với 1 click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Cookie Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
